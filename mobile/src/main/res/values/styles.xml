<resources>

    <!-- Base application theme. DayNight lets Android WebView see the correct
         prefers-color-scheme value when the user chooses "System" in aw-webui.
         The AppCompatDelegate.MODE_NIGHT_FOLLOW_SYSTEM call in AWApplication
         ensures the mode is set before any Activity starts. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

        <item name="android:textColor">@color/default_text_color</item>
    </style>
    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    <!-- Light-only theme for native screens that pin their background to
         chrome_light via applySafeWindowInsets(). DayNight would resolve
         text colour attributes (textColorSecondary, textAppearanceListItem …)
         to white in night mode while the background stays white → unreadable.
         Theme.AppCompat.Light.NoActionBar already disables the window action
         bar, so no extra item overrides are needed. -->
    <style name="AppTheme.LightOnly" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>
    <!-- DayNight theme for native screens that call
         applySafeWindowInsets(followNightMode = true), so text colour attributes
         and the chrome_light/chrome_dark background flip together. Unlike
         AppTheme it does not pin android:textColor to default_text_color,
         which is black in both modes. -->
    <style name="AppTheme.FollowNight" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>
    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Light"/>
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light"/>

    <!-- Automations editor ("Shortcuts" style). -->
    <style name="AutomationSectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/automation_text_secondary</item>
    </style>
    <style name="AutomationCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_automation_card</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
    <style name="AutomationRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="AutomationRowLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/automation_text_primary</item>
    </style>
    <style name="AutomationDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1px</item>
        <item name="android:background">@color/automation_divider</item>
    </style>
    <style name="AutomationField">
        <item name="android:background">@drawable/bg_automation_field</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/automation_text_primary</item>
        <item name="android:textColorHint">@color/automation_text_secondary</item>
        <item name="android:importantForAutofill">no</item>
    </style>
    <style name="AutomationLinkButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/colorAccent</item>
    </style>
    <style name="AutomationSegment">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_automation_segment_option</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/automation_text_primary</item>
    </style>

</resources>
