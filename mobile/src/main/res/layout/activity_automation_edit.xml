<?xml version="1.0" encoding="utf-8"?>
<!-- Root FrameLayout takes the window chrome colour from applySafeWindowInsets; the
     grouped grey "Shortcuts" background lives on the ScrollView inside it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/automation_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/automation_screen_bg"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- ============ WHEN ============ -->
            <TextView
                style="@style/AutomationSectionLabel"
                android:text="@string/automation_when" />

            <LinearLayout style="@style/AutomationCard">

                <LinearLayout style="@style/AutomationRow">
                    <TextView
                        style="@style/AutomationRowLabel"
                        android:text="@string/automation_when_label" />
                    <Spinner
                        android:id="@+id/spinner_trigger"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp" />
                </LinearLayout>

                <View style="@style/AutomationDivider" />

                <LinearLayout style="@style/AutomationRow">
                    <TextView
                        style="@style/AutomationRowLabel"
                        android:text="@string/automation_target_type_label" />
                    <Spinner
                        android:id="@+id/spinner_target_type"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp" />
                </LinearLayout>

                <View
                    android:id="@+id/divider_target_value"
                    style="@style/AutomationDivider" />

                <LinearLayout
                    android:id="@+id/row_target_value"
                    style="@style/AutomationRow">
                    <TextView
                        android:id="@+id/tv_target_value_label"
                        style="@style/AutomationRowLabel"
                        android:text="@string/automation_target_app_label" />
                    <Spinner
                        android:id="@+id/spinner_target_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_target_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="10dp"
                    android:textColor="@color/automation_text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <View
                    android:id="@+id/divider_min_duration"
                    style="@style/AutomationDivider" />

                <LinearLayout
                    android:id="@+id/row_min_duration"
                    style="@style/AutomationRow">
                    <TextView
                        style="@style/AutomationRowLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/automation_min_duration_label" />
                    <EditText
                        android:id="@+id/et_min_duration"
                        style="@style/AutomationField"
                        android:layout_width="88dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:hint="@string/automation_min_duration_hint"
                        android:inputType="number" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ DO: Get contents of URL ============ -->
            <TextView
                style="@style/AutomationSectionLabel"
                android:text="@string/automation_do" />

            <LinearLayout
                style="@style/AutomationCard"
                android:paddingTop="14dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_automation_action_icon"
                        android:contentDescription="@null"
                        android:padding="5dp"
                        android:src="@drawable/ic_automation_globe" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/automation_action_title"
                        android:textColor="@color/automation_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <EditText
                    android:id="@+id/et_url"
                    style="@style/AutomationField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/automation_url_hint"
                    android:inputType="textUri" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/automation_url_help"
                    android:textColor="@color/automation_text_secondary"
                    android:textSize="12sp" />

                <View style="@style/AutomationDivider" />

                <LinearLayout style="@style/AutomationRow">
                    <TextView
                        style="@style/AutomationRowLabel"
                        android:text="@string/automation_method_label" />
                    <Spinner
                        android:id="@+id/spinner_method"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp" />
                </LinearLayout>

                <View style="@style/AutomationDivider" />

                <TextView
                    style="@style/AutomationRowLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/automation_headers_label" />

                <LinearLayout
                    android:id="@+id/headers_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/btn_add_header"
                    style="@style/AutomationLinkButton"
                    android:text="@string/automation_add_header" />

                <LinearLayout
                    android:id="@+id/section_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View style="@style/AutomationDivider" />

                    <LinearLayout
                        style="@style/AutomationRow"
                        android:layout_marginTop="4dp">
                        <TextView
                            style="@style/AutomationRowLabel"
                            android:text="@string/automation_body_label" />
                        <RadioGroup
                            android:id="@+id/radio_body_type"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_automation_segment_track"
                            android:orientation="horizontal">
                            <RadioButton
                                android:id="@+id/radio_body_json"
                                style="@style/AutomationSegment"
                                android:text="@string/automation_body_json" />
                            <RadioButton
                                android:id="@+id/radio_body_form"
                                style="@style/AutomationSegment"
                                android:text="@string/automation_body_form" />
                            <RadioButton
                                android:id="@+id/radio_body_text"
                                style="@style/AutomationSegment"
                                android:text="@string/automation_body_text" />
                        </RadioGroup>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/fields_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/btn_add_field"
                        style="@style/AutomationLinkButton"
                        android:text="@string/automation_add_field" />

                    <EditText
                        android:id="@+id/et_body"
                        style="@style/AutomationField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="10dp"
                        android:fontFamily="monospace"
                        android:gravity="top|start"
                        android:hint="@string/automation_body_text_hint"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:minLines="6"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ Variables ============ -->
            <TextView
                style="@style/AutomationSectionLabel"
                android:text="@string/automation_variables" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/variables_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingStart="16dp"
                android:text="@string/automation_variables_help"
                android:textColor="@color/automation_text_secondary"
                android:textSize="12sp" />

            <!-- ============ Name ============ -->
            <TextView
                style="@style/AutomationSectionLabel"
                android:text="@string/automation_name_label" />

            <LinearLayout style="@style/AutomationCard">
                <EditText
                    android:id="@+id/et_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="@string/automation_name_hint"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:minHeight="50dp"
                    android:textColor="@color/automation_text_primary"
                    android:textColorHint="@color/automation_text_secondary"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_test_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:paddingStart="16dp"
                android:textColor="@color/automation_text_primary"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_delete"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/automation_delete"
                    android:textColor="@color/automation_remove" />

                <Button
                    android:id="@+id/btn_test"
                    style="@style/Widget.AppCompat.Button.Borderless.Colored"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/automation_test" />

                <Button
                    android:id="@+id/btn_save"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/automation_save" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
