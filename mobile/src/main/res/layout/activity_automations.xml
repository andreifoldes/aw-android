<?xml version="1.0" encoding="utf-8"?>
<!-- Root FrameLayout takes the window chrome colour from applySafeWindowInsets; the
     grouped grey "Shortcuts" background lives on the ScrollView inside it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/automations_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/automation_screen_bg"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/automations_intro"
                android:textColor="@color/automation_text_secondary"
                android:textSize="14sp" />

            <TextView
                style="@style/AutomationSectionLabel"
                android:text="@string/automations" />

            <LinearLayout style="@style/AutomationCard">

                <!-- Rules are added here programmatically -->
                <LinearLayout
                    android:id="@+id/automations_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/automations_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="50dp"
                    android:gravity="center_vertical"
                    android:text="@string/automations_empty"
                    android:textColor="@color/automation_text_secondary"
                    android:textSize="16sp" />

                <View style="@style/AutomationDivider" />

                <TextView
                    android:id="@+id/btn_add_automation"
                    style="@style/AutomationLinkButton"
                    android:layout_width="match_parent"
                    android:minHeight="50dp"
                    android:text="@string/automations_add" />
            </LinearLayout>

            <TextView
                style="@style/AutomationSectionLabel"
                android:text="@string/automations_detection_heading" />

            <LinearLayout style="@style/AutomationCard">

                <LinearLayout style="@style/AutomationRow">
                    <TextView
                        style="@style/AutomationRowLabel"
                        android:text="@string/automations_poll_label" />
                    <Spinner
                        android:id="@+id/spinner_poll_interval"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="12dp"
                    android:text="@string/automations_poll_help"
                    android:textColor="@color/automation_text_secondary"
                    android:textSize="13sp" />

                <View style="@style/AutomationDivider" />

                <TextView
                    android:id="@+id/tv_fast_path_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/automation_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btn_enable_fast_path"
                    style="@style/AutomationLinkButton"
                    android:text="@string/automations_open_accessibility" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
